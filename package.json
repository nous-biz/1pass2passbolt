{
  "name": "1pass2passbolt",
  "version": "0.1.0",
  "description": "Migrate 1Password vaults into Passbolt folders: one item becomes exactly one resource, original field labels preserved.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nous-biz/1pass2passbolt.git"
  },
  "bin": {
    "1pass2passbolt": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node src/bin.ts",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
